.food-element-page{min-height:100vh;padding:12rpx 16rpx 24rpx;background:#f2f4f7;-webkit-box-sizing:border-box;box-sizing:border-box}.state-card{margin-top:16rpx;padding:16rpx;background:#fff;border:1rpx solid #e7e9ee;border-radius:10rpx;color:#6b7482;text-align:center}.detail-content{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:14rpx}.product-card{background:#fff;border:1rpx solid #e6e8ed;border-radius:10rpx;padding:10rpx}.product-image-wrap{width:100%;height:236rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;overflow:hidden;border-radius:8rpx;background:#f4f5f7}.product-image{width:168rpx;max-width:68%;height:220rpx;border-radius:6rpx;background:transparent}.product-name{margin-top:10rpx;color:#2f3745;font-size:22rpx;font-weight:600;line-height:1.35}.product-meta{margin-top:4rpx;color:#7a8391;font-size:12rpx;line-height:1.4}.tag-row{margin-top:10rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:6rpx}.tag-chip{border-radius:999rpx;padding:4rpx 10rpx;font-size:11rpx;font-weight:600;color:#54b1e6;background:#e9f5fd}.table-section{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:8rpx}.table-title-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;color:#3c4452}.table-title{font-size:20rpx;font-weight:600}.table-count{font-size:14rpx;font-weight:600;color:#5e6775}.table-wrapper{border:1rpx solid #e3e6ec;background:#fff}.table-row{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:stretch;-ms-flex-align:stretch;align-items:stretch}.table-header{background:#f4f5f7;color:#7b8493;font-size:12rpx;font-weight:600}.table-body{border-top:1rpx solid #eceef2;font-size:13rpx;color:#4b5563}.col{-webkit-box-sizing:border-box;box-sizing:border-box;padding:10rpx 8rpx;border-right:1rpx solid #eceef2;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;line-height:1.4}.col:last-child{border-right:none}.col-name{width:34%;color:#2f3745;font-weight:500}.col-risk{width:14%;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.col-tag{width:25%;color:#5c6675}.col-effect{width:27%;color:#6b7482}.risk-badge{min-width:22rpx;height:22rpx;border-radius:50%;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;font-size:12rpx;font-weight:700}.risk-badge.risk-low{background:#e7f7ef;color:#1f9d55}.risk-badge.risk-medium{background:#eaf3fb;color:#2f9ed7}.risk-badge.risk-high{background:#fdebec;color:#dc2626}.risk-badge.risk-unknown{background:#eef2f7;color:#6b7280}.table-empty{padding:18rpx 12rpx;text-align:center;color:#8b94a2;font-size:13rpx}
