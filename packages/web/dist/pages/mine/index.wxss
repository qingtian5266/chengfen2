.mine-shell{position:relative;min-height:100vh;padding:40rpx;overflow:hidden}.mine-shell .ambient{position:absolute;border-radius:999rpx;pointer-events:none}.mine-shell .ambient-a{width:420rpx;height:420rpx;top:-180rpx;left:-80rpx;background:-webkit-radial-gradient(circle,rgba(111,197,255,.38) 0%,rgba(111,197,255,0) 70%);background:radial-gradient(circle,rgba(111,197,255,.38) 0%,rgba(111,197,255,0) 70%)}.mine-shell .ambient-b{width:400rpx;height:400rpx;top:180rpx;right:-160rpx;background:-webkit-radial-gradient(circle,rgba(173,200,255,.3) 0%,rgba(173,200,255,0) 68%);background:radial-gradient(circle,rgba(173,200,255,.3) 0%,rgba(173,200,255,0) 68%)}.mine-shell .profile-wrap{position:relative;z-index:2;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-animation:rise-in .45s ease-out;animation:rise-in .45s ease-out}.mine-shell .profile-avatar{width:170rpx;height:170rpx;border-radius:50%;-webkit-box-shadow:0 20rpx 44rpx rgba(88,129,194,.2);box-shadow:0 20rpx 44rpx #5881c233;margin-top:48rpx}.mine-shell .avatar-fallback{background:-webkit-linear-gradient(290deg,#9cd6ff 0%,#59acef 100%);background:linear-gradient(160deg,#9cd6ff 0%,#59acef 100%);color:#fff;font-size:66rpx;font-weight:700;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.mine-shell .nickname{margin-top:22rpx;font-size:58rpx;font-weight:700;color:#1f2d4c}.mine-shell .openid{margin-top:10rpx;color:#7e8ca9;font-size:24rpx;word-break:break-all}.mine-shell .login-btn{margin-top:24rpx;width:220rpx;height:68rpx;border-radius:999rpx;background:-webkit-linear-gradient(290deg,#5bc4ff 0%,#2e95dd 100%);background:linear-gradient(160deg,#5bc4ff 0%,#2e95dd 100%);color:#fff;font-size:28rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.mine-shell .shortcut-card{position:relative;z-index:2;margin-top:38rpx;padding:30rpx 16rpx;border-radius:28rpx;background:rgba(255,255,255,.88);border:2rpx solid rgba(126,180,230,.2);-webkit-box-shadow:0 18rpx 48rpx rgba(99,137,195,.14);box-shadow:0 18rpx 48rpx #6389c324;display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx}.mine-shell .shortcut-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:12rpx}.mine-shell .shortcut-ico{width:64rpx;height:64rpx;border-radius:50%;background:-webkit-linear-gradient(290deg,#d7efff 0%,#9ed6fb 100%);background:linear-gradient(160deg,#d7efff 0%,#9ed6fb 100%);color:#3d8ed0;font-size:30rpx;font-weight:700;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.mine-shell .shortcut-text{font-size:28rpx;color:#2d3f62}.mine-shell .menu-card{position:relative;z-index:2;margin-top:18rpx;border-radius:28rpx;background:rgba(255,255,255,.9);border:2rpx solid rgba(126,180,230,.2);-webkit-box-shadow:0 18rpx 48rpx rgba(99,137,195,.12);box-shadow:0 18rpx 48rpx #6389c31f;overflow:hidden}.mine-shell .menu-row{height:108rpx;padding:0 26rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;border-top:1rpx solid rgba(122,164,212,.16)}.mine-shell .menu-row:first-child{border-top:none}.mine-shell .menu-row-danger .menu-name,.mine-shell .menu-row-danger .menu-ico{color:#e06c73}.mine-shell .menu-left{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:18rpx}.mine-shell .menu-ico{width:50rpx;height:50rpx;border-radius:50%;border:2rpx solid rgba(69,115,170,.25);color:#3f5280;font-size:24rpx;font-weight:700;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.mine-shell .menu-name{font-size:32rpx;color:#283b60}.mine-shell .menu-arrow{color:#a8b2c6;font-size:44rpx;line-height:1}@-webkit-keyframes rise-in{0%{opacity:0;-webkit-transform:translateY(22rpx);transform:translateY(22rpx)}to{opacity:1;-webkit-transform:translateY(0);transform:translateY(0)}}@keyframes rise-in{0%{opacity:0;-webkit-transform:translateY(22rpx);transform:translateY(22rpx)}to{opacity:1;-webkit-transform:translateY(0);transform:translateY(0)}}
