.collect-shell{min-height:100vh;padding:calc(env(safe-area-inset-top) + 18rpx) 20rpx 26rpx}.collect-shell .top-bar{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;padding:10rpx 6rpx 14rpx}.collect-shell .back{width:56rpx;height:56rpx;border-radius:50%;border:2rpx solid rgba(66,93,145,.26);color:#243a62;font-size:44rpx;line-height:46rpx;text-align:center}.collect-shell .title{font-size:52rpx;font-weight:700;color:#235}.collect-shell .right-actions{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:12rpx}.collect-shell .action{min-width:68rpx;height:56rpx;padding:0 16rpx;border-radius:999rpx;color:#425680;border:2rpx solid rgba(66,93,145,.2);display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;font-size:28rpx}.collect-shell .category-tabs{margin-top:4rpx;height:92rpx;border-radius:18rpx;background:rgba(255,255,255,.86);border:2rpx solid rgba(136,176,226,.2);display:-webkit-flex;display:-ms-flexbox;display:flex;overflow:hidden}.collect-shell .tab{-webkit-flex:1;-ms-flex:1;flex:1;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;font-size:36rpx;color:#54658c}.collect-shell .tab-active{color:#23395f;font-weight:700;position:relative}.collect-shell .tab-active:after{content:"";position:absolute;bottom:10rpx;width:46rpx;height:6rpx;border-radius:999rpx;background:#4db6f5}.collect-shell .empty-card{margin-top:24rpx;border-radius:26rpx;background:rgba(255,255,255,.9);border:2rpx solid rgba(136,176,226,.2);text-align:center;padding:80rpx 20rpx;color:#7483a1;font-size:32rpx}.collect-shell .collect-list{margin-top:22rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:16rpx}.collect-shell .collect-card{border-radius:26rpx;background:rgba(255,255,255,.93);border:2rpx solid rgba(136,176,226,.2);-webkit-box-shadow:0 14rpx 34rpx rgba(95,132,189,.12);box-shadow:0 14rpx 34rpx #5f84bd1f;padding:16rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:16rpx;-webkit-align-items:stretch;-ms-flex-align:stretch;align-items:stretch}.collect-shell .thumb{width:170rpx;border-radius:18rpx;background:-webkit-linear-gradient(290deg,#f4f8ff 0%,#d7e7ff 100%);background:linear-gradient(160deg,#f4f8ff 0%,#d7e7ff 100%);border:2rpx solid rgba(138,180,224,.26);color:#40608d;font-size:38rpx;font-weight:700;text-align:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:10rpx}.collect-shell .info{-webkit-flex:1;-ms-flex:1;flex:1;min-width:0;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column}.collect-shell .name{font-size:40rpx;line-height:1.3;color:#223458;font-weight:700}.collect-shell .meta{margin-top:8rpx;font-size:30rpx;color:#7180a0}.collect-shell .chips{margin-top:12rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:10rpx}.collect-shell .chip{min-height:44rpx;padding:0 14rpx;border-radius:999rpx;background:rgba(87,183,242,.15);color:#2f8ecc;font-size:24rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.collect-shell .chip-warning{background:rgba(244,178,90,.16);color:#d19137}.collect-shell .risk-line{margin-top:12rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:10rpx}.collect-shell .risk-dot{width:14rpx;height:14rpx;border-radius:50%}.collect-shell .dot-high{background:#ea6d77}.collect-shell .dot-medium{background:#f0a64a}.collect-shell .dot-low{background:#3fbf86}.collect-shell .risk-text{font-size:28rpx;color:#415474}.collect-shell .delete-btn{-webkit-align-self:center;-ms-flex-item-align:center;align-self:center;min-width:88rpx;height:56rpx;border-radius:999rpx;background:rgba(237,108,118,.13);color:#d9606a;font-size:26rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding:0 14rpx}
