.home-page{position:relative;min-height:100vh;padding:40rpx;overflow:hidden;background:-webkit-linear-gradient(282deg,#dff3ff 0%,#edf4ff 48%,#f6f8ff 100%),-webkit-radial-gradient(85% 6%,circle,rgba(139,214,255,.44) 0%,rgba(139,214,255,0) 52%),-webkit-radial-gradient(6% 25%,circle,rgba(167,218,255,.36) 0%,rgba(167,218,255,0) 46%);background:linear-gradient(168deg,#dff3ff 0%,#edf4ff 48%,#f6f8ff 100%),radial-gradient(circle at 85% 6%,rgba(139,214,255,.44) 0%,rgba(139,214,255,0) 52%),radial-gradient(circle at 6% 25%,rgba(167,218,255,.36) 0%,rgba(167,218,255,0) 46%)}.home-page .bg-overlay{position:absolute;inset:0;background:-webkit-linear-gradient(318deg,rgba(255,255,255,0) 32%,rgba(195,218,255,.24) 62%,rgba(255,255,255,0) 82%);background:linear-gradient(132deg,rgba(255,255,255,0) 32%,rgba(195,218,255,.24) 62%,rgba(255,255,255,0) 82%);pointer-events:none}.home-page .top-meta{position:relative;z-index:2;margin-top:10rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between}.home-page .location-pill{height:50rpx;border-radius:999rpx;background:rgba(92,186,246,.2);border:1rpx solid rgba(105,186,237,.26);color:#3f5f8f;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:0 16rpx;font-size:28rpx;gap:8rpx}.home-page .pill-dot{width:16rpx;height:16rpx;border-radius:50%;background:#4fb2ec;position:relative}.home-page .pill-dot:after{content:"";position:absolute;left:6rpx;top:6rpx;width:8rpx;height:8rpx;border-radius:50%;background:#fff;opacity:.9}.home-page .pill-arrow{width:0;height:0;border-left:6rpx solid transparent;border-right:6rpx solid transparent;border-top:8rpx solid #54a8df;margin-top:4rpx}.home-page .user-avatar{width:66rpx;height:66rpx;border-radius:50%;background:-webkit-linear-gradient(300deg,#ffd9b1 0%,#f3b48c 34%,#648fce 100%);background:linear-gradient(150deg,#ffd9b1 0%,#f3b48c 34%,#648fce 100%);border:3rpx solid rgba(255,255,255,.8);-webkit-box-shadow:0 8rpx 20rpx rgba(91,126,183,.24);box-shadow:0 8rpx 20rpx #5b7eb73d}.home-page .weather-row{position:relative;z-index:2;margin-top:22rpx;color:#324a78;font-size:28rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:10rpx;letter-spacing:.2rpx}.home-page .weather-text{-webkit-flex:1;-ms-flex:1;flex:1;white-space:nowrap}.home-page .sun-icon{width:24rpx;height:24rpx;border-radius:50%;background:#f69f98;-webkit-box-shadow:0 0 0 5rpx rgba(246,159,152,.24);box-shadow:0 0 0 5rpx #f69f983d;margin-right:4rpx}.home-page .weather-arrow{color:#58698e;font-size:34rpx;line-height:1}.home-page .brand-block{position:relative;z-index:2;margin-top:240rpx;text-align:center}.home-page .brand-title-row{display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:14rpx}.home-page .brand-logo{width:64rpx;height:64rpx;border-radius:50%;background:rgba(89,189,241,.2);border:2rpx solid rgba(92,186,241,.6);position:relative;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.home-page .brand-logo:before,.home-page .brand-logo:after{content:"";position:absolute;top:-6rpx;width:12rpx;height:12rpx;border-radius:3rpx;border:2rpx solid #5ab8ed;background:#e6f6ff;-webkit-transform:rotate(45deg);-ms-transform:rotate(45deg);transform:rotate(45deg)}.home-page .brand-logo:before{left:14rpx}.home-page .brand-logo:after{right:14rpx}.home-page .cat-face{width:30rpx;height:24rpx;border:2rpx solid #56b5ea;border-radius:999rpx 999rpx 12rpx 12rpx;position:relative}.home-page .cat-face:before,.home-page .cat-face:after{content:"";position:absolute;top:9rpx;width:4rpx;height:4rpx;border-radius:50%;background:#56b5ea}.home-page .cat-face:before{left:7rpx}.home-page .cat-face:after{right:7rpx}.home-page .brand-title{color:#43ace9;font-size:66rpx;line-height:1;font-weight:700;letter-spacing:2rpx}.home-page .brand-sub{margin-top:24rpx;color:#55aedd;font-size:30rpx}.home-page .search-bar{position:relative;z-index:2;margin:0 auto;margin-top:78rpx;width:96%;height:120rpx;border-radius:54rpx;border:4rpx solid #4eb3ed;background:rgba(255,255,255,.78);-webkit-box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.65);box-shadow:inset 0 0 0 1rpx #ffffffa6;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:0 22rpx 0 36rpx}.home-page .search-input{-webkit-flex:1;-ms-flex:1;flex:1;height:100%;font-size:28rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.home-page .search-icons{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;gap:8rpx}.home-page .icon-btn{width:50rpx;height:50rpx;border-radius:50%;color:#5a6386;font-size:40rpx;font-weight:500;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.home-page .suggest-panel{position:relative;z-index:4;margin-top:14rpx;border-radius:24rpx;background:rgba(255,255,255,.92);border:1rpx solid rgba(122,174,226,.26);overflow:hidden}.home-page .suggest-item{min-height:76rpx;padding:0 26rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;color:#3f567f;font-size:32rpx;border-top:1rpx solid rgba(130,171,220,.2)}.home-page .suggest-item:first-child{border-top:none}.home-page .action-row{position:relative;z-index:2;margin-top:120rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.home-page .action-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center}.home-page .action-orb{width:90rpx;height:90rpx;border-radius:50%;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;position:relative}.home-page .action-orb:after{content:"";position:absolute;inset:-16rpx;border-radius:50%;-webkit-filter:blur(4rpx);filter:blur(4rpx);z-index:-1}.home-page .orb-core{width:56rpx;height:56rpx;border-radius:16rpx;background:rgba(255,255,255,.22);color:#fff;font-size:32rpx;font-weight:700;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.home-page .orb-blue{background:-webkit-radial-gradient(24% 20%,circle,#9cd9ff 0%,#45a9f0 74%);background:radial-gradient(circle at 24% 20%,#9cd9ff 0%,#45a9f0 74%)}.home-page .orb-blue:after{background:rgba(90,157,240,.24)}.home-page .orb-green{background:-webkit-radial-gradient(24% 20%,circle,#a4efd8 0%,#43c49a 74%);background:radial-gradient(circle at 24% 20%,#a4efd8 0%,#43c49a 74%)}.home-page .orb-green:after{background:rgba(77,192,145,.24)}.home-page .orb-violet{background:-webkit-radial-gradient(24% 20%,circle,#cac4ff 0%,#7d76f4 74%);background:radial-gradient(circle at 24% 20%,#cac4ff 0%,#7d76f4 74%)}.home-page .orb-violet:after{background:rgba(130,113,241,.24)}.home-page .action-label{margin-top:24rpx;color:#353a56;font-size:28rpx;font-weight:500}.home-page .quick-row{position:relative;z-index:2;margin-top:44rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:10%;padding:0 16rpx}.home-page .quick-pill{-webkit-flex:1;-ms-flex:1;flex:1;height:60rpx;border-radius:999rpx;margin-top:32rpx;border:1rpx solid rgba(134,187,230,.34);background:rgba(255,255,255,.46);color:#7fa7c8;font-size:28rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.home-page .review-row{position:relative;z-index:2;margin-top:126rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;gap:10rpx;color:#63abd5;font-size:38rpx}.home-page .review-icon{font-size:32rpx;line-height:1}.home-page .review-arrow{font-size:38rpx;line-height:1}
